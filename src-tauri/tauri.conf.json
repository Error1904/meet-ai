{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adrishyaa-Local",
  "version": "0.1.0",
  "identifier": "com.adrishyaa.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Adrishyaa-Local - AI Meeting Co-Pilot",
        "width": 1180,
        "height": 780,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      },
      {
        "label": "stealth",
        "title": "Adrishyaa Stealth Bar",
        "width": 820,
        "height": 140,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
